{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotori True Liquid Glass companion status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instanceId", "pid", "pluginEnabled", "requestedRevision", "appliedRevision", "requestedEnabled", "quality", "status", "reason", "updatedAt", "heartbeatExpiresAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instanceId": { "type": "string", "format": "uuid" },
    "pid": { "type": "integer", "minimum": 1 },
    "pluginEnabled": { "type": "boolean" },
    "requestedRevision": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "appliedRevision": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "requestedEnabled": { "type": "boolean" },
    "quality": { "enum": ["low", "balanced", "high"] },
    "status": { "enum": ["active", "disabled", "suspended", "fallback", "error"] },
    "reason": { "type": ["string", "null"], "maxLength": 256 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "heartbeatExpiresAt": { "type": "string", "format": "date-time" }
  }
}
