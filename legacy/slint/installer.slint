import { ScrollView, ComboBox, Slider, Palette } from "std-widgets.slint";
import { Artwork } from "artworks.slint";
export struct Setting { name: string, label: string, hint: string, section: string, value: string, kind: int, choices: [string], swatch: color, alpha-enabled: bool, opacity-value: float, unit: string }
component GlassButton inherits Rectangle {
    in property <image> surface;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    background: transparent;
    Image { source: root.surface; width: parent.width; height: parent.height; opacity: root.enabled ? 1 : 0.45; }
    Rectangle { border-radius: 18px; background: area.pressed && root.enabled ? #ffffff16 : area.has-hover && root.enabled ? #ffffff10 : transparent; }
    Text { text: root.label; color: root.enabled ? #fff3ef : #999090; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    area := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}
component CustomizePanel inherits Rectangle {
    callback back;
    in property <[Setting]> settings;
    in property <string> status;
    in property <bool> preview-mode;
    callback edit(int, string);
    callback pick-color(int);
    callback opacity-edit(int, float);
    callback save;
    Image { source: Artwork.editor-background; width: parent.width; height: parent.height; }
    GlassButton { x: 24px; y: 24px; width: 160px; height: 54px; surface: Artwork.editor-save; label: "Back"; clicked => { root.back(); } }
    Text { x: 210px; y: 26px; text: "Make Hotori yours"; color: #fff2ed; font-size: 30px; font-weight: 600; }
    Text { x: 28px; y: 88px; text: "Glass, color, and atmosphere. Fine-tune every detail of your Discord."; color: #e2bdb1; font-size: 14px; }
    Image { x: 24px; y: 124px; width: parent.width - 48px; height: parent.height - 220px; source: Artwork.editor-content; }
    ScrollView {
        x: 38px; y: 138px; width: parent.width - 76px; height: parent.height - 248px;
        VerticalLayout {
            padding: 10px; spacing: 12px;
            for setting[index] in root.settings: VerticalLayout {
                spacing: 8px;
                if setting.section != "": Text { text: setting.section; color: #f3b5a5; font-size: 17px; font-weight: 600; height: 34px; }
                Rectangle {
                    height: 90px; border-radius: 14px; background: #14090b55; border-width: 1px; border-color: #ffffff22;
                    Text { x: 14px; y: 12px; text: setting.label; color: #fff0e9; font-size: 15px; font-weight: 600; }
                    Text { x: 14px; y: 40px; width: 340px; text: setting.hint; color: #d4b7ad; font-size: 11px; wrap: word-wrap; }
                    if setting.kind == 1: ComboBox {
                        x: 400px; y: 24px; width: parent.width - 414px; height: 42px;
                        model: setting.choices; current-value: setting.value;
                        selected(value) => { root.edit(index, value); }
                    }
                    if setting.kind == 2: Rectangle {
                        x: 400px; y: 14px; width: parent.width - 414px; height: 66px; background: transparent;
                        Rectangle {
                            width: 38px; height: 32px; border-radius: 8px; background: setting.swatch;
                            border-width: 1px; border-color: #ffffff66;
                        }
                        Text { x: 50px; y: 7px; text: "Choose Color"; color: #fff0e9; font-size: 14px; }
                        TouchArea { height: 32px; mouse-cursor: pointer; clicked => { root.pick-color(index); } }
                        if setting.alpha-enabled: HorizontalLayout {
                            y: 38px; height: 26px; spacing: 8px;
                            Text { text: "Opacity"; color: #d4b7ad; font-size: 11px; vertical-alignment: center; }
                            Slider { minimum: 0; maximum: 100; value: setting.opacity-value * 100; changed(value) => { root.opacity-edit(index, value / 100); } }
                            Text { text: round(setting.opacity-value * 100) + "%"; width: 35px; color: #fff0e9; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    if setting.kind == 0 || setting.kind == 3: Rectangle {
                        x: 400px; y: 24px; width: parent.width - 414px; height: 42px; border-radius: 10px; border-width: 1px; border-color: input.has-focus ? #ffc8b8aa : #ffffff35; background: #10060966;
                        input := TextInput { x: 12px; y: 10px; width: parent.width - (setting.unit == "" ? 24px : 88px); height: 24px; text: setting.value; color: #fff0e9; selection-background-color: #8d3434; font-size: 13px; single-line: true; edited => { root.edit(index, self.text); } }
                        Text { x: parent.width - 68px; y: 12px; width: 58px; text: setting.unit; color: #d4b7ad; font-size: 12px; }
                    }
                }
            }
        }
    }
    if root.status != "": Rectangle {
        x: 24px; y: parent.height - 78px; width: parent.width - 310px; height: 54px; background: transparent;
        Image { source: Artwork.editor-notification; width: parent.width; height: parent.height; }
        Text { x: 14px; y: 8px; width: parent.width - 28px; height: 38px; text: root.status; color: #ffe5dc; wrap: word-wrap; font-size: 12px; }
    }
    GlassButton { x: parent.width - 268px; y: parent.height - 78px; width: 244px; height: 54px; surface: Artwork.editor-save; label: "Save changes"; enabled: !root.preview-mode; clicked => { root.save(); } }
}
export component InstallerWindow inherits Window {
    title: "Hotori · Theme Installer";
    preferred-width: 1120px; preferred-height: 630px;
    min-width: 1120px; min-height: 630px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in-out property <bool> settings-open: false;
    in property <[Setting]> settings;
    in property <string> editor-status;
    in property <bool> preview-mode;
    callback edit(int, string);
    callback pick-color(int);
    callback opacity-edit(int, float);
    callback save;
    private property <float> settings-position: root.settings-open ? 1 : 0;
    animate settings-position { duration: 280ms; easing: ease-in-out; }
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> installed;
    in property <string> status;
    callback install;
    callback uninstall;
    callback customize;
    callback open-folder;
    Rectangle {
        width: parent.width; height: parent.height; clip: true;
        Rectangle {
            x: -root.settings-position * parent.width;
            width: parent.width; height: parent.height;
            visible: root.settings-position < 1;
            Image { source: Artwork.background; width: parent.width; height: parent.height; image-fit: fill; }
            Image { x: 38px; y: 34px; width: 500px; height: 126px; source: @image-url("../assets/logo.png"); image-fit: contain; }
            Text { x: 40px; y: 178px; text: "If only the snow could fall slower..."; color: #f3c7ba; font-size: 16px; }
            Image { x: 38px; y: 222px; width: 500px; height: 204px; source: Artwork.panel; }
            VerticalLayout {
                x: 60px; y: 241px; width: 456px; height: 161px; spacing: 12px;
                Text { text: "Vencord Installation is necessary for theme to function."; color: #f1b6a5; font-size: 12px; wrap: word-wrap; }
                Text { text: "Install your Hotori theme."; color: #fff4ee; font-size: 27px; font-weight: 600; }
                Text { text: "A Discord theme inspired by Liquid Glass. Make it yours with acrylic or liquid glass, custom backgrounds, colors and blur. Adjust avatar size and shape, message spacing, mention highlights, and your server list layout."; color: #e6d0ca; font-size: 14px; wrap: word-wrap; }
            }
            Rectangle { x: 38px; y: 451px; width: 500px; height: 1px; background: #ffffff35; }
            GlassButton { x: 38px; y: 476px; width: 243px; height: 54px; surface: Artwork.install; label: root.busy ? "Working…" : root.installed ? "Installed" : "Install"; enabled: root.ready && !root.busy && !root.installed; clicked => { root.install(); } }
            GlassButton { x: 295px; y: 476px; width: 243px; height: 54px; surface: Artwork.uninstall; label: "Uninstall"; enabled: root.installed && !root.busy; clicked => { root.uninstall(); } }
            GlassButton { x: 38px; y: 544px; width: 243px; height: 54px; surface: Artwork.customize; label: "Customize"; enabled: root.installed && !root.busy; clicked => { root.customize(); } }
            GlassButton { x: 295px; y: 544px; width: 243px; height: 54px; surface: Artwork.folder; label: "Open Theme Folder"; enabled: !root.busy; clicked => { root.open-folder(); } }
            if root.status != "": Rectangle {
                x: 574px; y: 532px; width: 508px; height: 66px; background: transparent;
                Image { source: Artwork.notification; width: parent.width; height: parent.height; }
                Text { x: 14px; y: 10px; width: parent.width - 28px; height: parent.height - 20px; text: root.status; color: #f0d5cb; wrap: word-wrap; font-size: 13px; }
            }
        }
        CustomizePanel {
            x: (1 - root.settings-position) * parent.width;
            width: parent.width; height: parent.height;
            visible: root.settings-position > 0;
            settings: root.settings;
            status: root.editor-status;
            preview-mode: root.preview-mode;
            back => { root.settings-open = false; }
            edit(index, value) => { root.edit(index, value); }
            pick-color(index) => { root.pick-color(index); }
            opacity-edit(index, value) => { root.opacity-edit(index, value); }
            save => { root.save(); }
        }
    }
}
