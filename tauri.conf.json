{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotori",
  "version": "1.3.3",
  "identifier": "com.hotori.theme-installer",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotori",
        "width": 1600,
        "height": 900,
        "minWidth": 560,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#160b10",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
